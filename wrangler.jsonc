{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticket-lite",
  "main": "dist/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "RESEND_FROM_EMAIL": "Ticket Lite <donotreply@ticketlite.ca>"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
